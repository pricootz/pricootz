<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
  <ribbon>
    <tabs>
      <tab id="tabPricopTools" label="Pricop Tools" keytip="P">
        <group id="grpAlign" label="Allinea">
          <button id="btnAlignLeft" label="Sinistra" size="large" getImage="GetImage" onAction="AlignLeft" keytip="L"/>
          <button id="btnAlignCenter" label="Centro" size="large" getImage="GetImage" onAction="AlignCenter" keytip="C"/>
          <button id="btnAlignRight" label="Destra" size="large" getImage="GetImage" onAction="AlignRight" keytip="R"/>
          <button id="btnAlignTop" label="Alto" getImage="GetImage" onAction="AlignTop" keytip="T"/>
          <button id="btnAlignMiddle" label="Mezzo" getImage="GetImage" onAction="AlignMiddle" keytip="M"/>
          <button id="btnAlignBottom" label="Basso" getImage="GetImage" onAction="AlignBottom" keytip="B"/>
        </group>
        <group id="grpDist" label="Distribuisci">
          <button id="btnDistH" label="Orizzontale" size="large" getImage="GetImage" onAction="DistributeH" keytip="H"/>
          <button id="btnDistV" label="Verticale" size="large" getImage="GetImage" onAction="DistributeV" keytip="V"/>
        </group>
        <group id="grpSize" label="Dimensioni">
          <button id="btnSameWidth" label="Stessa larghezza" getImage="GetImage" onAction="SameWidth" keytip="W"/>
          <button id="btnSameHeight" label="Stessa altezza" getImage="GetImage" onAction="SameHeight" keytip="E"/>
          <button id="btnSameSize" label="Stessa dimensione" size="large" getImage="GetImage" onAction="SameSize" keytip="S"/>
        </group>
        <group id="grpShape" label="Forma">
          <button id="btnRect" label="Rettangolo" size="large" getImage="GetImage" onAction="Rectangle" keytip="Q"/>
          <button id="btnRound" label="Arrotondato" size="large" getImage="GetImage" onAction="RoundedRectangle" keytip="A"/>
        </group>
        <group id="grpStyle" label="Stile">
          <button id="btnShadowOff" label="No ombra" getImage="GetImage" onAction="ShadowOff" keytip="O"/>
          <button id="btnShadowOn" label="Ombra" getImage="GetImage" onAction="ShadowOn" keytip="D"/>
          <button id="btnLineOff" label="No bordo" getImage="GetImage" onAction="LineOff" keytip="N"/>
          <button id="btnLineOn" label="Bordo" getImage="GetImage" onAction="LineOn" keytip="I"/>
          <button id="btnMatchStyle" label="Copia stile" size="large" getImage="GetImage" onAction="MatchStyle" keytip="F"/>
        </group>
        <group id="grpSmart" label="Smart">
          <button id="btnClean" label="Clean boxes" size="large" getImage="GetImage" onAction="CleanBoxes" keytip="X"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
